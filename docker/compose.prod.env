# THIS IS A .ENV TEMPLATE FILE FOR DOCKER COMPOSE FOR USING THE SYSTEM AS IF IT WERE A PRODUCTION-LIKE ENVIRONMENT. RENAME IT TO .env AND MODIFY THE VALUES AS NEEDED
# WARNING: Do not use example credentials in real production. Replace all passwords and secrets before deployment.

COMPOSE_NAME="openlysis"

#
# Services
#

# Database
DATABASE_CONTAINER_NAME="database"
PGUSER=postgres
POSTGRES_PORT="5432"
POSTGRES_PASSWORD="dba"
API_DB_USER_NAME="openlysis_api"
API_USER_DB_PASSWORD="Openlysis-Strong-Password-1234"
API_DB_NAME="openlysis"

# RabbitMq
BROKER_CONTAINER_NAME="broker"
RABBITMQ_NODE_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"
RABBITMQ_VIRTUAL_HOST="/"
RABBITMQ_DEFAULT_USER="Openlysis"
RABBITMQ_DEFAULT_PASS="Openlysis-Strong-Password-1234"

#
#   App
#

# Shared
APP_ENVIRONMENT=Development # You can set this to "Production" to also use Google Cloud Storage, but the APIs will require HTTPS.
API_CONNECTION_STRING="Server=database; Port=5432; Database=openlysis; Username=openlysis_api; Password=Openlysis-Strong-Password-1234; SslMode=Disable; TrustServerCertificate=true;"
API_TEMP_FILE_STORAGE_FILEPATH="/tmp" # Only used in dev environments.

# API
API_CONTAINER_NAME="api"
API_CONFIG_SOURCE_FILEPATH="./settings-templates/api.settings.prod.json"
API_CONFIG_TARGET_FILEPATH="/app/appsettings.json"
API_SECRETS_FILEPATH="~/.microsoft/usersecrets/ef94f7b8-50cd-4943-b8c5-1058f97df21b/secrets.json"
API_PORT=8080
API_PORT_2=8081
API_BUILD_CONFIGURATION="Release"
DOPPLER_API_SERVICE_TOKEN="" # Fill with your Doppler service token

# Auth
AUTH_CONTAINER_NAME="auth"
AUTH_CONFIG_SOURCE_FILEPATH="./settings-templates/auth.settings.prod.json"
AUTH_CONFIG_TARGET_FILEPATH="/app/appsettings.json"
AUTH_BUILD_CONFIGURATION="Release"
AUTH_PORT=5000
AUTH_PORT_2=5001
DOPPLER_AUTH_SERVICE_TOKEN="" # Fill with your Doppler service token

# Analysis Orchestrator
ANALYSIS_ORCHESTRATOR_CONTAINER_NAME="analysis-orchestrator"
ANALYSIS_ORCHESTRATOR_CONFIG_SOURCE_FILEPATH="./settings-templates/orchestrator.settings.prod.json"
ANALYSIS_ORCHESTRATOR_CONFIG_TARGET_FILEPATH="/app/appsettings.json"
ANALYSIS_ORCHESTRATOR_BUILD_CONFIGURATION="Release"
ANALYSIS_ORCHESTRATOR_MIGRATIONS_CONTAINER_NAME="analysis-orchestrator-migrations"
ANALYSIS_ORCHESTRATOR_MIGRATIONS_CONFIG_TARGET_FILEPATH="/src/Infrastructure/Services/Openlysis.AnalysisOrchestrator/appsettings.json"
DOPPLER_ANALYSIS_ORCHESTRATOR_SERVICE_TOKEN="" # Fill with your Doppler service token