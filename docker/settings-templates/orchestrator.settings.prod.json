        "Suspicious": [
          "Suspicious"
        ],
        "Undetected": [
          "Undetected",
          "Clean",
          "Benign",
          "NoThreat"
        ]
      },
      "AlertMessages": {
        "Malicious": [
          "Phishing - NakedPages Phishing Kit",
