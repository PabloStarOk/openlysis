  "Filescan": {
    "Analyzer": {
      "ServiceName": "Filescan",
      "ApiKeyHeaderName": "X-Api-Key",
      "BaseAddress": "https://www.filescan.io/api/",
      "RequestsTimeoutMs": 120000,
      "AnalyzeConsumeRequest": true,
      "GetStatusConsumeRequest": false,
      "GetAnalysisConsumeRequest": false,
      "FileMaxSizeInBytes": 103809024
    },
    "RateQuotaService": {
      "RateWindowRefreshIntervalMs": 1000,
      "RateQuota": {
        "AnalyzeEndpoint": {
          "EndpointTypes": [
            "Analyze"
          ],
          "MinuteRate": 0,
          "HourlyRate": 60,
          "DailyQuota": 0,
          "MonthlyQuota": 0
        }
      }
    }
  },
  "UrlQuery": {
    "Analyzer": {
      "ServiceName": "UrlQuery",
      "ApiKeyHeaderName": "x-apikey",
      "BaseAddress": "https://api.urlquery.net/public/v1/",
      "RequestsTimeoutMs": 120000,
      "DefaultUserAgent": "Mobile",
      "AnalyzeConsumeRequest": false,
      "GetStatusConsumeRequest": false,
      "GetAnalysisConsumeRequest": false
    },
    "VerdictCalculation": {
      "MaliciousVerdictCountThreshold": 1,
      "SuspiciousVerdictCountThreshold": 1,
      "MaliciousAlertMessageThreshold": 1,
      "SuspiciousAlertMessageThreshold": 1,
