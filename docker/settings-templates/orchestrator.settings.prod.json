  "HybridAnalysis": {
    "Analyzer": {
      "ServiceName": "HybridAnalysis",
      "ApiKeyHeaderName": "api-key",
      "BaseAddress": "https://hybrid-analysis.com/api/v2/",
      "RequestsTimeoutMs": 120000,
      "UserAgent": "Falcon Sandbox",
      "DefaultSandboxEnvironment": "Windows11x64",
