@OpenlysisAPIHostAddress = http://localhost:5248/api/v1
@SampleFileAnalysisId = 5bd9ae5a-6a3c-44a4-9b1c-1d7ecabd97f5
@SampleFileAnalysisSha256 = SHA256

// Get by ID
GET {{OpenlysisAPIHostAddress}}/analyses/file/{{SampleFileAnalysisId}}
Accept: application/json
###

// Get by hash
GET {{OpenlysisAPIHostAddress}}/analyses/file/hash/{{SampleFileAnalysisSha256}}
Accept: application/json
###

// Analyze file
POST {{OpenlysisAPIHostAddress}}/analyses/file
Accept: application/json
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="file"; filename="sample.txt"
Content-Type: text/plain; charset=UTF-8

This is a sample text
--Boundary
Content-Disposition: form-data; name="reanalyze";
Content-Type: text/plain

true
--Boundary
###